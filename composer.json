{
  "name": "latentkit/laravel",
  "description": "Official Laravel integration for LatentKit's route-based AI gateway.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "LatentKit",
      "homepage": "https://latentkit.com"
    }
  ],
  "homepage": "https://docs.latentkit.com/integrations/laravel",
  "support": {
    "docs": "https://docs.latentkit.com/integrations/laravel",
    "issues": "https://github.com/amirehman/latentkit-laravel/issues",
    "source": "https://github.com/amirehman/latentkit-laravel"
  },
  "keywords": [
    "ai",
    "laravel",
    "latentkit",
    "llm"
  ],
  "require": {
    "php": "^8.3",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "laravel/ai": "^0.9.1",
    "latentkit/latentkit-php": "^0.1.0-beta.3@beta"
  },
  "conflict": {
    "league/commonmark": "<2.10.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.26",
    "orchestra/testbench": "^10.6 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "LatentKit\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LatentKit\\Laravel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --debug",
    "lint": "pint --test",
    "test": "phpunit",
    "check": [
      "@analyse",
      "@lint",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "LatentKit\\Laravel\\LatentKitServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
